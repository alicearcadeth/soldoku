{
  "name": "sudoku-v2-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sudoku-v2-staging",
      "database_id": "455d7d3e-682b-47b3-8995-261b31a320d8"
    }
  ]
}
