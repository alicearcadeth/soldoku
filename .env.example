# Copy to a file that stays outside Git. `.env` and `config/operator.env` are ignored.
# Placeholders below are fake. Ordinary Classic, Practice, tests, and the web build
# do not need any of these values.

# --- Local gameplay (optional) ---
# Default RPC is http://127.0.0.1:8899. The hosted site does not read this file.
# SOLANA_RPC=http://127.0.0.1:8899
# SOLANA_RPC_BACKUP=
# SOLANA_CLUSTER=devnet
# PORT=4173

# --- Tests (optional) ---
# SUDOKU_MATCH_STORE is a local JSON path. Tests set it themselves.
# SUDOKU_FUNDING_PAUSED=1
# SUDOKU_DFLOW_LIVE=0
# DFLOW_API_KEY=dfk_example_not_a_real_key
# SUDOKU_MOONPAY_LIVE=0
# MOONPAY_PUBLISHABLE_KEY=pk_test_example
# MOONPAY_SECRET_KEY=sk_test_example
# MOONPAY_WEBHOOK_KEY=whsec_example

# --- Worker deploy (privileged, optional for development) ---
# Authenticate the Wrangler CLI separately. Do not put a Cloudflare token here.
# ARTPORTAL_SOLANA_RPC_URL=https://example.invalid/devnet
# SUDOKU_AUTHORITY_KEY=
# SUDOKU_ESCROW_PROGRAM_ID=937BAWXVCW58oEKkA1FijkSXXtdgGEytUyPRV2Roge22
# SUDOKU_ESCROW_V2=1
# SUDOKU_MINT=J7STDEHGniYdSjuY4HKZMoSdr1KckYiGNdfnmsrYiLw7
# SUDOKU_STAGING=0
# SUDOKU_REVEAL must stay unset on the public Devnet worker.

# --- Devnet financial operations (privileged) ---
# Key files live in ~/.config/solana and are never committed.
# SUDOKU_IMPORT_WALLET_FILE=
# SUDOKU_IMPORT_PLAYER_B_FILE=
# SOLANA_BIN=
# SUDOKU_WSL_HOME=
# SUDOKU_WSL_USER=

# --- Android release signing (privileged, not needed to read or run the web app) ---
# SOLANA_MOBILE_KEYSTORE_PATH=
# SOLANA_MOBILE_KEYSTORE_ALIAS=sudoku-release
# SOLANA_MOBILE_KEYSTORE_PASSWORD=
# SOLANA_MOBILE_KEY_PASSWORD=
# SOLANA_MOBILE_URL=https://sudoku.jamesbitarcade.workers.dev/

# --- Optional local tools ---
# JUPITER_API_KEY=  # Server-side verified token discovery; never use a VITE_ prefix.
# JAVA_HOME=
# ANDROID_HOME=
# CHROME_PATH=
# PHANTOM_EXTENSION_DIR=
# QA_ORIGIN=https://sudoku.jamesbitarcade.workers.dev/
# GAME_URL=http://127.0.0.1:5174
